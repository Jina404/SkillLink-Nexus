# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser. Everything else stays on the server.

# --- Form email (required in production) ---
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Where every form submission is sent (hello@skilllinknexus.com).
FORMS_INBOX=
# Sender shown on form emails, on a domain verified in Resend,
# for example: SkillLink Nexus <forms@skilllinknexus.com>
FORMS_FROM=

# --- Rate limiting (optional, recommended in production) ---
# Without these, a basic per-server memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile spam check (optional; set both or neither) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Extra hosts allowed to submit forms (optional) ---
# skilllinknexus.com and www.skilllinknexus.com are always allowed; localhost is allowed in development.
# Comma separated, for example a preview deployment: my-preview.vercel.app
FORMS_ALLOWED_HOSTS=

# --- Call booking (optional) ---
# Override for the discovery-call scheduler (defaults to brand.schedulerUrl in data/navigation.ts).
# Works with Cal.com, Calendly, or Microsoft Bookings. Cal.com and Calendly links get the visitor's
# name, email, and service pre-filled.
NEXT_PUBLIC_SCHEDULER_URL=
